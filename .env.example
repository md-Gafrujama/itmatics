# Public site URL (Vercel Production — must match primary domain / Search Console)
NEXT_PUBLIC_SITE_URL=https://www.itmaticsnews.com

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic — console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key

# Pexels — pexels.com/api (free)
PEXELS_API_KEY=your-pexels-api-key

# Shared secret for /api/cron/generate-article and /api/admin/bootstrap
CRON_SECRET=generate-a-long-random-string

# Nodemailer SMTP (Gmail: use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="ITmatics News <your-email@gmail.com>"

# First-party analytics + optional Google Analytics (Consent Mode)
# Set NEXT_PUBLIC_SITE_ANALYTICS=false to disable beacons entirely.
NEXT_PUBLIC_SITE_ANALYTICS=true
# NEXT_PUBLIC_SITE_ANALYTICS_URL=https://www.itmaticsnews.com/api/public/site-analytics/event
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Admin bootstrap (used once by npm run bootstrap — never commit real values)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
