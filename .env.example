# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (set this on Vercel to your real domain - no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.itmaticsnews.com

# Anthropic — console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key

# Pexels — pexels.com/api (free)
PEXELS_API_KEY=your-pexels-api-key

# Shared secret for /api/cron/generate-article and /api/admin/bootstrap
CRON_SECRET=your-random-cron-secret

# Nodemailer SMTP (Gmail: use App Password at myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="ITmatics News <you@gmail.com>"

# Optional: base URL for npm run generate:topics (defaults to NEXT_PUBLIC_SITE_URL or localhost)
# GENERATE_BASE_URL=http://localhost:3000

# Admin login (created by npm run bootstrap)
ADMIN_EMAIL=you@gmail.com
ADMIN_PASSWORD=your-secure-password
